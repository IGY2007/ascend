# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API).
# La anon key es pública por diseño: la seguridad la da Row Level Security.
# NUNCA pongas acá la service_role key.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Ruta base del sitio. En GitHub Pages es /<nombre-del-repo>/. En local podés dejarla vacía.
# VITE_BASE_PATH=/ascend/
