{
  "name": "ascend",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "description": "ASCEND — Build yourself. Track your progress.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "seed:exercises": "node scripts/generate-exercises-migration.mjs",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.types.ts",
    "test:rls": "node --env-file-if-exists=.env.local scripts/test-rls.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^7.0.9",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.80.0",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.4.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2",
    "workbox-build": "^7.4.1"
  }
}
